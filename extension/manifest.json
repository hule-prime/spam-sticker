{
  "manifest_version": 3,
  "name": "KuKu Sticker ×3",
  "version": "1.3.0",
  "description": "Chọn danh sách sticker trả lời và theo dõi bằng menu chuột phải. Gom 2 giây, tối đa 3 sticker, không cộng dồn.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "action": {
    "default_title": "KuKu Sticker ×3",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://kuku.vn/*", "https://www.kuku.vn/*"],
      "js": ["core.js", "page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://kuku.vn/*", "https://www.kuku.vn/*"],
      "js": ["content.bundle.js"],
      "run_at": "document_start"
    }
  ]
}
